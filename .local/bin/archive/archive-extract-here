#!/bin/sh


for file in "$@"; do
	case "$file" in
		*.tar.bz2 | *.tbz2) tar -xvjf "$file" ;;
		*.tar.gz | *.tgz) tar -xvzf "$file" ;;
		*.tar.xz) tar -xvJf "$file" ;;
		*.tar) tar -xvf "$file" ;;
		*.bz2) pbzip2 -d "$file" ;;
		*.gz) unpigz "$file" ;;
		*.xz) unxz --threads=0 "$file" ;;
		*.zip) unzip "$file" ;;
		*)
			echo "Don't know how to extract '$file'" >&2
			return 1
			;;
	esac
done
