#!/bin/sh


tarinfo() {
	sed -E 's|([^/]*/?).*|\1|' <<<"$1" | uniq
}

for file in "$@"; do
	case "$file" in
		*.tar.bz2 | *.tbz2) tarinfo "$(tar -tjf "$file")" ;;
		*.tar.gz | *.tgz) tarinfo "$(tar -tzf "$file")" ;;
		*.tar.xz) tarinfo "$(tar -tJf "$file")" ;;
		*.tar) tarinfo "$(tar -tf "$file")" ;;
		*.zip) zipinfo -1 "$file" ;;
		*)
			echo "Don't know how to list '$file'..." >&2
			return 1
			;;
	esac
done
