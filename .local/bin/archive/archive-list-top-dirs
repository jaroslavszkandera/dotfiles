#!/bin/bash


parseinfo() {
	sed -E 's|([^/]*/?).*|\1|' <<<"$1" | uniq
}

for file in "$@"; do
	case "$file" in
		*.tar.bz2 | *.tbz2) parseinfo "$(tar -tjf "$file")" ;;
		*.tar.gz | *.tgz) parseinfo "$(tar -tzf "$file")" ;;
		*.tar.xz) parseinfo "$(tar -tJf "$file")" ;;
		*.tar) parseinfo "$(tar -tf "$file")" ;;
		*.zip) parseinfo "$(zipinfo -1 "$file")" ;;
		*)
			echo "Don't know how to list '$file'..." >&2
			return 1
			;;
	esac
done
