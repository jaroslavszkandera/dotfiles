#!/bin/bash


FILE_PKGS_COMMON="$(dirname "$0")/../src/generated/pkglist_common.txt"
FILE_PKGS_HOST_SPECIFIC="$(dirname "$0")/../src/generated/pkglist_${HOSTNAME}.txt"

get_help() {
	echo "Usage: $(basename "$0") [OPTIONS] [FILES]"
	echo "Auxiliary script to help manage pkglist."
	echo
	echo "Options:"
	echo "[FILES]         Sync installed packages based on given files"
	echo "-g [OUTPUT]     Generate file containing packages installed on the current machine minus pkglist_common.txt"
	exit 127
}

# TODO: mark installed as explicit/dependencies

install_pkgs() {
	[ -n "$*" ] && echo "$@" | yay -Syu --needed "${install_flags[@]}" -
}

uninstall_pkgs() {
	[ -n "$*" ] && echo "$@" | sudo pacman -Rnus -
}

[ ! -d "$(dirname "$FILE_PKGS_OUTPUT")" ] && get_help

PKGS_CURRENT="$(pacman -Qqe | sort)"
install_flags=()
while [ "$#" -gt 0 ]; do
	case "$1" in
		-h)	get_help ;;
		-g)
			comm --check-order -23 <(echo "$PKGS_CURRENT") "$FILE_PKGS_COMMON" >"$FILE_PKGS_HOST_SPECIFIC"
			exit
			;;
		--noconfirm)
			install_flags+=("$1")
			shift
			;;
		*)
			if [ -f "$1" ]; then
				FILE_PKGS_TARGET+=("$1")
			else
				get_help
			fi
			shift
			;;
	esac
done

[ "${#FILE_PKGS_TARGET[@]}" -eq 0 ] && echo "Please specify file containing packages" && exit 1
PKGS_TARGET="$(cat "${FILE_PKGS_TARGET[@]}")"

pkgs_to_uninstall="$(comm --check-order -23 <(echo "$PKGS_CURRENT") <(sort <<<"$PKGS_TARGET"))"
pkgs_to_install="$(comm --check-order -23 <(sort <<<"$PKGS_TARGET") <(echo "$PKGS_CURRENT"))"

uninstall_pkgs "$pkgs_to_uninstall"
exit_uninstall=$?
install_pkgs "$pkgs_to_install"
exit_install=$?

exit $((exit_install > exit_uninstall ? exit_install : exit_uninstall))
