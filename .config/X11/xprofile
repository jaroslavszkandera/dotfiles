#!/bin/sh


# System bar
dwmblocks &
nm-applet &
redshift-gtk &

# Deamons
unclutter &
udiskie &
dunst &
background &

# Peripherals
numlockx on &
xrdb -load "${XDG_CONFIG_HOME}/X11/Xresources" &

# Other
rfkill block bluetooth &
[ "$(hostname)" = 'XPS15' ] && \
	picom -CGb --experimental-backends --config="${XDG_CONFIG_HOME}/picom/picom_$(hostname).conf" &

# tmux
tmux-init &
