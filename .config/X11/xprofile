#!/bin/bash
# This file is sourced by xinit/display managers before window manager is started


# System bar
dwmblocks &
nm-applet &
redshift-gtk &

# Deamons
unclutter &
udiskie &
dunst &
background &

# Peripherals
numlockx on &
xrdb -load "${XDG_CONFIG_HOME}/X11/Xresources" &

# Other
systemctl --user import-environment DISPLAY & # Used by netword-clipboard
PICOM_PROFILE="${XDG_CONFIG_HOME}/picom/picom_$(hostname).conf"
[ -f "$PICOM_PROFILE" ] && picom -b --config="$PICOM_PROFILE" &
