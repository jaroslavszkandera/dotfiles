xwayland enable
default_orientation horizontal
default_border pixel 1
smart_borders on
show_marks yes
mouse_warping output
focus_wrapping workspace
focus_follows_mouse no

# swaymsg -t get_tree
# app_id: wayland, class/instance: x11
for_window {
	[app_id="firefox"] move container to workspace 2
	[class="Chromium"] move container to workspace 2
	[app_id="anki"] move container to workspace 4
	[class="Spotify"] move container to workspace 5
	# TODO
	[app_id="Spotify"] move container to workspace 5
	[app_id="thunderbird"] move container to workspace 6
	[app_id="Slack"] move container to workspace 6
	[app_id="dragon"] sticky enable floating enable
}

for_window [shell="xwayland"] title_format "[XWayland] %title"

# TODO: theme
# client.focused

include input
include output
include binds
include /etc/sway/config.d/*
